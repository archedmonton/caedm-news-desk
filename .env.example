# Template only. Never commit real secrets.
# Local development: copy to .env (git-ignored). Leave DATABASE_URL empty and keep email simulated.
# Production: a separate git-ignored .env.vercel, imported into Vercel (Settings > Environment Variables,
# Production only). Production values are noted beside each setting. See docs/DEPLOYMENT.md.

# --- Database ---------------------------------------------------------------
# Local: leave empty to use the built-in embedded Postgres (PGlite) in ./data/pglite.
# Production (Supabase > Connect): "Transaction pooler", port 6543, e.g.
#   postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Production: "Session pooler", port 5432 (same host). Used for migrations. Don't use "Direct connection": it is IPv6-only.
DATABASE_URL_DIRECT=
# Connections per server instance (keep small on serverless)
DATABASE_POOL_MAX=3

# --- App ----------------------------------------------------------------------
# Public URL of the app, used in email links. Production: https://caedm-news-desk.vercel.app
APP_URL=http://localhost:3000
# Only addresses at this domain can sign in, be invited, or request access
ALLOWED_EMAIL_DOMAIN=caedm.ca
# Developer contact: help & support, feature requests, protected developer admin account
DEVELOPER_NAME="Ruban Peppin"
DEVELOPER_EMAIL=ruban.peppin@caedm.ca

# --- Scheduler ------------------------------------------------------------------
# Production only. Shared secret for /api/cron/tick; Vercel Cron sends it as "Authorization: Bearer <secret>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Access -----------------------------------------------------------------
# Development-only sign-in shortcut. Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=true
# Production: true. Sign-in also requires live email (EMAIL_LIVE_SEND=true plus a real transport).
PRODUCTION_ACCESS_ENABLED=false

# --- Email ----------------------------------------------------------------------
# outbox (simulated, default) | smtp | graph. Production: smtp
EMAIL_TRANSPORT=outbox
# Live sending is OFF by default. Production only: true, after IT approval. Never true locally.
EMAIL_LIVE_SEND=false
EMAIL_FROM="CAEDM News Desk <notifications@caedm.ca>"

# SMTP (approved relay), provided by IT
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Microsoft Graph (alternative): app registration with Mail.Send scoped to one mailbox
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# Identifying User-Agent for source monitoring
FETCH_USER_AGENT="CAEDM-NewsDesk/0.1 (+https://caedm.ca; communications monitoring; contact communications@caedm.ca)"
