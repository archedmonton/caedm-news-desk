{
  "name": "caedm-news-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c blue,magenta \"next dev\" \"npm:worker\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-setup.ts --migrate-only",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed:sample": "tsx scripts/db-setup.ts --sample",
    "collect": "tsx scripts/collect.ts",
    "digest:preview": "tsx scripts/digest-preview.ts",
    "alerts:dry-run": "tsx scripts/alerts-dry-run.ts",
    "admin:invite": "tsx scripts/admin-invite.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "15.5.28",
    "nodemailer": "^10.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
