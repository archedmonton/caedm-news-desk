# Copy to .env.local for development. Never commit real secrets.

# SQLite database file (created automatically)
DATABASE_PATH=./data/caedm-news-desk.db

# Public URL of the app (used in email links)
APP_URL=http://localhost:3000

# Only addresses at this domain can be invited
ALLOWED_EMAIL_DOMAIN=caedm.ca

# Development-only sign-in shortcut. Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=true

# Production sign-in stays disabled until this is true AND live email transport is configured.
PRODUCTION_ACCESS_ENABLED=false

# Email: outbox (simulated, default) | smtp | graph
EMAIL_TRANSPORT=outbox
# Live sending is OFF by default. Set to true only after IT approval.
EMAIL_LIVE_SEND=false
EMAIL_FROM="CAEDM News Desk <newsdesk@caedm.ca>"

# SMTP (approved relay) — provided by IT
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Microsoft Graph (optional alternative) — app registration with Mail.Send scoped to one mailbox
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# Developer contact: help & support, feature requests, protected developer admin account
DEVELOPER_NAME="Ruban Peppin"
DEVELOPER_EMAIL=ruban.peppin@caedm.ca

# Identifying User-Agent for source monitoring
FETCH_USER_AGENT="CAEDM-NewsDesk/0.1 (+https://caedm.ca; communications monitoring; contact communications@caedm.ca)"
