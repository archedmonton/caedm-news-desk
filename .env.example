# Copy to .env.local for development. Never commit real secrets.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# --- Database ---------------------------------------------------------------
# Production (Supabase): "Transaction pooler" connection string, port 6543.
# Leave empty locally to use the built-in embedded Postgres (PGlite) in ./data/pglite.
DATABASE_URL=
# Supabase "Session pooler" or "Direct" connection string (port 5432), used only by `npm run db:migrate`.
DATABASE_URL_DIRECT=
# Connections per server instance (keep small on serverless)
DATABASE_POOL_MAX=3

# --- App ----------------------------------------------------------------------
# Public URL of the app (used in email links), e.g. https://caedm-news-desk.vercel.app
APP_URL=http://localhost:3000
# Only addresses at this domain can sign in, be invited, or request access
ALLOWED_EMAIL_DOMAIN=caedm.ca
# Developer contact: help & support, feature requests, protected developer admin account
DEVELOPER_NAME="Ruban Peppin"
DEVELOPER_EMAIL=ruban.peppin@caedm.ca

# --- Scheduler ------------------------------------------------------------------
# Shared secret for /api/cron/tick. Vercel Cron sends it automatically as "Authorization: Bearer <secret>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Access -----------------------------------------------------------------
# Development-only sign-in shortcut. Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=true
# Production sign-in stays disabled until this is true AND live email transport is configured.
PRODUCTION_ACCESS_ENABLED=false

# --- Email ----------------------------------------------------------------------
# outbox (simulated, default) | smtp | graph
EMAIL_TRANSPORT=outbox
# Live sending is OFF by default. Set to true only after IT approval.
EMAIL_LIVE_SEND=false
EMAIL_FROM="CAEDM News Desk <newsdesk@caedm.ca>"

# SMTP (approved relay), provided by IT
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Microsoft Graph (alternative): app registration with Mail.Send scoped to one mailbox
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# Identifying User-Agent for source monitoring
FETCH_USER_AGENT="CAEDM-NewsDesk/0.1 (+https://caedm.ca; communications monitoring; contact communications@caedm.ca)"
